<Window x:Class="LenovoController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LenovoController"
        mc:Ignorable="d"
        Title="Lenovo Controller"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        SourceInitialized="Window_SourceInitialized"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        DpiChanged="Window_DpiChanged"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        x:Name="mainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Padding="17,14,17,16"
            Background="Transparent"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel x:Name="ContentRoot" Opacity="1">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ContentSlide" Y="0" />
                </TransformGroup>
            </StackPanel.RenderTransform>
            <StackPanel.RenderTransformOrigin>0.5,0.5</StackPanel.RenderTransformOrigin>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           Text="{x:Static local:Localization.HeaderTitle}" />

                <Button x:Name="btnRefresh"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btnRefresh_Click"
                        ToolTip="{x:Static local:Localization.RefreshTooltip}">
                    <TextBlock x:Name="RefreshGlyph"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               RenderTransformOrigin="0.5,0.5"
                               Text="&#xE72C;">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RefreshRotation" Angle="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="btnMenu"
                        Grid.Column="2"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btnMenu_Click"
                        ToolTip="{x:Static local:Localization.MoreTooltip}">
                    <TextBlock FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Text="&#xE712;" />
                </Button>
            </Grid>

            <StackPanel Margin="0,15,0,0">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Static local:Localization.ChargingSection}" />
                <Border Margin="0,6,0,0" Style="{StaticResource SegmentHostStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="radioConservation"
                                     Content="{x:Static local:Localization.BatteryConservation}"
                                     GroupName="BatteryMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioBattery_Checked" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioNormalCharge"
                                     Grid.Column="2"
                                     Content="{x:Static local:Localization.BatteryNormal}"
                                     GroupName="BatteryMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioBattery_Checked" />
                        <Border Grid.Column="3" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioRapidCharge"
                                     Grid.Column="4"
                                     Content="{x:Static local:Localization.BatteryRapid}"
                                     GroupName="BatteryMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioBattery_Checked" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,13,0,0">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Static local:Localization.AlwaysOnUsbSection}" />
                <Border Margin="0,6,0,0" Style="{StaticResource SegmentHostStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="radioAlwaysOnUsbOff"
                                     Content="{x:Static local:Localization.UsbOff}"
                                     GroupName="AlwaysOnUsb"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioAlwaysOnUsb_Checked" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioAlwaysOnUsbOnWhenSleeping"
                                     Grid.Column="2"
                                     Content="{x:Static local:Localization.UsbOnSleep}"
                                     GroupName="AlwaysOnUsb"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioAlwaysOnUsb_Checked" />
                        <Border Grid.Column="3" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioAlwaysOnUsbOnAlways"
                                     Grid.Column="4"
                                     Content="{x:Static local:Localization.UsbAlways}"
                                     GroupName="AlwaysOnUsb"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioAlwaysOnUsb_Checked" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,13,0,0">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Static local:Localization.PowerModeSection}" />
                <Border Margin="0,6,0,0" Style="{StaticResource SegmentHostStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="radioQuiet"
                                     Content="{x:Static local:Localization.PowerModeQuiet}"
                                     GroupName="PowerMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioPowerMode_Checked" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioBalance"
                                     Grid.Column="2"
                                     Content="{x:Static local:Localization.PowerModeBalanced}"
                                     GroupName="PowerMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioPowerMode_Checked" />
                        <Border Grid.Column="3" Style="{StaticResource SegmentDividerStyle}" />
                        <RadioButton x:Name="radioPerformance"
                                     Grid.Column="4"
                                     Content="{x:Static local:Localization.PowerModePerformance}"
                                     GroupName="PowerMode"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="radioPowerMode_Checked" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chkOverDrive"
                          Content="{x:Static local:Localization.OverDrive}"
                          Style="{StaticResource Win11CheckBox}"
                          Checked="chkOverDrive_Checked"
                          Unchecked="chkOverDrive_Checked" />
                <CheckBox x:Name="chkFnLock"
                          Grid.Column="1"
                          Content="{x:Static local:Localization.FnLock}"
                          Style="{StaticResource Win11CheckBox}"
                          Checked="chkFnLock_Checked"
                          Unchecked="chkFnLock_Checked" />
                <CheckBox x:Name="chkTouchpadLock"
                          Grid.Column="2"
                          Content="{x:Static local:Localization.TouchpadLock}"
                          Style="{StaticResource Win11CheckBox}"
                          Checked="chkTouchpadLock_Checked"
                          Unchecked="chkTouchpadLock_Checked" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
